{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "HTTP Request Latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Rate Limit Drops",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(ratelimit_dropped_total[5m])) by (path)",
          "legendFormat": "{{prefix}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "drops/s"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 300,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(eventbus_published_total[5m])) by (event_type, outcome)",
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "expr": "sum(rate(eventbus_handled_total[5m])) by (event_type)",
          "legendFormat": "__auto",
          "refId": "B"
        },
        {
          "expr": "sum(rate(eventbus_failed_total[5m])) by (event_type)",
          "legendFormat": "__auto",
          "refId": "C"
        }
      ],
      "title": "Event Bus Throughput",
      "type": "timeseries",
      "description": "事件总线吞吐（published/handled/failed）"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 301,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(worker_jobs_total[5m])) by (worker_name, outcome)",
          "legendFormat": "__auto",
          "refId": "A"
        },
        {
          "expr": "worker_active_jobs",
          "legendFormat": "__auto",
          "refId": "B"
        }
      ],
      "title": "Worker Jobs",
      "type": "timeseries",
      "description": "后台 worker 启动计数与活跃实例"
    },
    {
      "title": "Go Runtime",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "goroutines"
        },
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "RSS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "title": "SLO Error Budget (30d remaining)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "1 - (sum(increase(http_requests_total{status_code=~\"5..\"}[30d])) / sum(increase(http_requests_total[30d]))) / 0.001",
          "legendFormat": "availability budget (99.9%)"
        },
        {
          "expr": "1 - (1 - sum(increase(http_request_duration_seconds_bucket{le=\"2\"}[30d])) / sum(increase(http_request_duration_seconds_count[30d]))) / 0.01",
          "legendFormat": "latency budget (99% <2s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -1,
          "max": 1
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "servify",
    "infrastructure"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Servify - Infrastructure",
  "uid": "servify-infrastructure"
}
