# 测试输出
scripts/test-results/*
!scripts/test-results/.gitkeep
!scripts/test-results/**/
scripts/test-results/**/*.json
!scripts/test-results/**/manifest.json
scripts/test-results/**/*.jsonl
scripts/test-results/**/*.txt
# auth-session 与 voice-pstn 验收证据全量入库（快照含本地验收环境的
# JWT/webhook secret，均为 127.0.0.1 + dev 密钥产物，作验收存档公开）
!scripts/test-results/auth-session-acceptance/**
!scripts/test-results/voice-pstn-acceptance/**
# ragflow 验收关键证据入库：manifest + summary + upload/sync/knowledge-docs
# CRUD 响应 + ai 状态/检索响应 + provider 协议留痕（jsonl）+ 服务启动日志。
# admin-auth.json 含验收 JWT，与 mock.log/mock-server.log（jsonl 已为副本）
# 一并排除。
!scripts/test-results/ragflow-acceptance/summary.txt
!scripts/test-results/ragflow-acceptance/knowledge-upload.json
!scripts/test-results/ragflow-acceptance/knowledge-upload-repeat.json
!scripts/test-results/ragflow-acceptance/knowledge-sync.json
!scripts/test-results/ragflow-acceptance/knowledge-docs-create.json
!scripts/test-results/ragflow-acceptance/knowledge-docs-get.json
!scripts/test-results/ragflow-acceptance/knowledge-docs-update.json
!scripts/test-results/ragflow-acceptance/knowledge-docs-delete.json
!scripts/test-results/ragflow-acceptance/knowledge-docs-get-after-delete.json
!scripts/test-results/ragflow-acceptance/ai-status.json
!scripts/test-results/ragflow-acceptance/ai-status-unauthorized.json
!scripts/test-results/ragflow-acceptance/ai-query.json
!scripts/test-results/ragflow-acceptance/ragflow-dataset.json
!scripts/test-results/ragflow-acceptance/ragflow-mock-requests.jsonl
!scripts/test-results/ragflow-acceptance/server-log.txt
# weknora 全栈 mock 验收证据入库：manifest 走全局白名单；此处收
# summary + 健康/AI 状态与查询（含 disable 降级路径）+ provider 控制面
# （disable/enable/熔断复位）+ 知识上传/同步 + ws/webrtc 状态。均为
# 127.0.0.1 mock 栈响应体，脚本的服务 JWT 只在内存中，不落盘。
!scripts/test-results/weknora-acceptance/summary.txt
!scripts/test-results/weknora-acceptance/servify-health.json
!scripts/test-results/weknora-acceptance/weknora-health.json
!scripts/test-results/weknora-acceptance/ai-status.json
!scripts/test-results/weknora-acceptance/ai-status-after-disable.json
!scripts/test-results/weknora-acceptance/ai-status-after-enable.json
!scripts/test-results/weknora-acceptance/ai-query.json
!scripts/test-results/weknora-acceptance/ai-query-after-disable.json
!scripts/test-results/weknora-acceptance/ai-metrics.json
!scripts/test-results/weknora-acceptance/ai-metrics-after-fallback.json
!scripts/test-results/weknora-acceptance/knowledge-provider-disable.json
!scripts/test-results/weknora-acceptance/knowledge-provider-enable.json
!scripts/test-results/weknora-acceptance/circuit-breaker-reset.json
!scripts/test-results/weknora-acceptance/knowledge-upload.json
!scripts/test-results/weknora-acceptance/knowledge-sync.json
!scripts/test-results/weknora-acceptance/ws-stats.json
!scripts/test-results/weknora-acceptance/webrtc-connections.json
# 全容器化 weknora 验收（2026-09-29）：servify 也进容器的整栈证据
# （响应 + manifest + 容器清单/日志留痕 + 配置快照；服务 JWT 只在内存不落盘）。
!scripts/test-results/weknora-acceptance-container/**
# compose 模板 servify 服务两缺陷修正（2026-09-29）端到端复证：
# 三容器 healthy + wget 探针日志 + 宿主 health 响应 + 摘要（无 secret）。
!scripts/test-results/compose-servify-fix/**
# perf 基线入库三件：manifest（check-acceptance-evidence 校验入口）、
# results.json（P2-8 容量基线数据，docs/perf-baseline.md 引用）、summary.txt
# （人读摘要）。其余原始证据（含 Authorization 头的 .headers 等）不入库。
!scripts/test-results/perf-baseline/results.json
!scripts/test-results/perf-baseline/summary.txt
scripts/test-results/perf-baseline/*.body
scripts/test-results/perf-baseline/*.headers
scripts/test-results/perf-baseline/*.log
# 主链路人工运行验证第二轮复跑证据全量入库（2026-09-27）：依赖状态、健康、
# 种子、登录（token 掩码）、dashboard/workspace、工单详情/改派前后、WS 收发
# 帧与 omni 消息读回。均为 127.0.0.1 + sqlite 回退 + dev JWT secret 产物。
!scripts/test-results/main-link-round2/**
# 运营高价值链路第一轮复跑证据全量入库（2026-09-27）：manifest 走全局白名单；
# 此处收 19 步响应体（客户/客服/安全/审计）+ summary。均为 127.0.0.1 +
# sqlite 回退 + dev JWT secret 产物，token 已掩码，CSV 内为合成测试客户。
!scripts/test-results/operations-round1/**

