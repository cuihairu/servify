{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servify-website",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "servify.cuihairu.site", "custom_domain": true }
  ]
}
